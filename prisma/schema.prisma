// Maithilika — Prisma schema.
//
// Deliberately small: four tables. Categories, motif meanings and store
// settings are constants in code. Customers sign in with Google, but buying
// stays open to guests; the admin signs in with a password from .env.
// See docs/plan.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  /// Readable slug, e.g. "saree-3". Used in product URLs.
  id String @id

  name    String
  /// clothing | homedecor | paintings | accessories
  section String
  /// Sarees, Stoles, On paper, Cushion covers, ...
  sub     String

  /// Whole rupees. Razorpay is charged price * 100 paise.
  price Int

  motif     String
  motifHi   String?
  motifText String?

  fabric   String?
  colour   String?
  style    String?
  medium   String?
  frame    String?
  edge     String?
  includes String?

  /// The single option group the design shows, e.g. "Size" with
  /// ["XS","S","M","L","XL","XXL"]. Null and empty when there is none.
  optionLabel String?
  options     String[]

  image String
  /// Crop rectangles for the gallery views and card framing, copied from
  /// Design/sarees.js (iw, ih, ar, cardW, cardPos, views).
  imageLayout Json?

  artistName    String?
  artistVillage String?
  paintedDays   Int?

  /// One-of-a-kind pieces (the default) become sold after one purchase.
  /// Made-to-order pieces are painted on demand and never sell out.
  madeToOrder  Boolean @default(false)
  leadTimeDays Int?
  sold         Boolean @default(false)

  /// Taken off the storefront without deleting.
  hidden   Boolean @default(false)
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, sold, hidden])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  /// Shown to the customer; with their email it looks up a guest order.
  orderNumber String      @unique
  status      OrderStatus @default(PENDING_PAYMENT)

  name  String
  email String
  phone String

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String

  /// Snapshot at purchase time, so later product edits never rewrite an
  /// order: [{ productId, name, option, price, qty }]. Prices in rupees.
  items    Json
  subtotal Int
  shipping Int
  total    Int

  razorpayOrderId   String? @unique
  /// Unique, so a repeated payment callback or webhook cannot pay twice.
  razorpayPaymentId String? @unique
  paidAt            DateTime?

  /// Pasted by the admin after booking the courier.
  trackingUrl String?
  /// Admin-only, e.g. "piece sold to another customer — refund".
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status, createdAt])
}

/// Created the first time someone signs in with Google. Only custom requests
/// need it; orders stay guest orders.
model Customer {
  id       String  @id @default(cuid())
  /// Google's permanent id for this person. Their email can change; this can't.
  googleId String  @unique
  email    String
  name     String
  /// Google doesn't share this. Asked once, then kept on the profile.
  phone    String?

  requests CustomRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A customer asking for a piece to be painted for them. The owner calls them back.
model CustomRequest {
  id String @id @default(cuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Saree | Painting
  type   String
  /// Silk | Cotton. Sarees only.
  fabric String?

  description String
  /// Copied from the profile when sent, as an order keeps its own details.
  name        String
  phone       String

  /// Set by the admin after calling the customer.
  contactedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([contactedAt, createdAt])
  @@index([customerId, createdAt])
}
