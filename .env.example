# Copy to .env and fill in. Never commit .env — it is gitignored.

# ── Database (Neon) ─────────────────────────────────────────────────────────
# Neon dashboard → Connect. Copy both strings; they are not interchangeable.
# Pooled (host contains "-pooler"): used by the app.
DATABASE_URL=
# Direct (no "-pooler"): used by migrations only.
DIRECT_URL=

# ── Admin ───────────────────────────────────────────────────────────────────
# Password for /admin. Use a long random one.
ADMIN_PASSWORD=
# Signs the admin login cookie. Any long random string.
ADMIN_SESSION_SECRET=

# ── Razorpay (test keys first: dashboard → Test mode → API keys) ───────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → add <site>/api/razorpay/webhook, event payment.captured
RAZORPAY_WEBHOOK_SECRET=
