# Copy to .env and fill in. Never commit .env — it is gitignored.
# Run scripts/setup-neon.sh to provision the database values interactively.

# ── Database (Neon) ────────────────────────────────────────────────────────
# Neon gives two connection strings for the same database. Both are needed,
# and they are not interchangeable.

# Pooled. Host contains "-pooler". Used by the app at runtime, because
# serverless functions open more connections than Postgres accepts directly.
DATABASE_URL=

# Direct. Host does NOT contain "-pooler". Used by Prisma Migrate only.
# Schema changes cannot run through the pooler: PgBouncer in transaction mode
# will not hold the session state DDL requires.
DIRECT_URL=

# ── Added in later phases ──────────────────────────────────────────────────
# Phase 3 — Google sign-in (client-owned Google Cloud project)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_SECRET=
#
# Phase 3 — transactional email, for order confirmations
# RESEND_API_KEY=
#
# Phase 4 — Razorpay (client-owned account; test mode first)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
